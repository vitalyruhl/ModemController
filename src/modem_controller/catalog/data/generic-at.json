          "category": "Maintenance",
          "kind": "at",
          "payload": "AT+CPIN={pin}",
          "help_text": "Unlocks a SIM only after an explicit maintenance confirmation. The PIN is transient and excluded from history, capture and reports.",
          "risk": "state_changing",
          "applicability": [
            "generic-at"
          ],
          "references": [
            "at-text-reference"
          ],
          "verification": "supported",
          "expected_response": "OK or CME error",
          "timeout_seconds": 10,
          "parameters": [
            {
              "name": "pin",
              "label": "SIM PIN",
              "required": true,
              "secret": true,
              "pattern": "[0-9]{4,8}"
